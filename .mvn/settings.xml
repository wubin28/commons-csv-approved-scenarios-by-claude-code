<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings for the training lab (mainland China network).
  Routes every repository request through the Aliyun public mirror so that
  `mvn test` works without touching ~/.m2/settings.xml.
  Activated by .mvn/maven.config (-s .mvn/settings.xml).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Maven public mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
